rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying all users
      
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200;

      allow update: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'favoriteChannels', 'reminderProgramIds', 'updatedAt']);

      allow delete: if isOwner(userId);
    }

    // Live Public Chat Messages Rules
    match /chat_messages/{messageId} {
      // Anyone can read chat messages in the live broadcast
      allow read: if true;

      // Authenticated users can post messages
      allow create: if isSignedIn()
        && isValidId(messageId)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.channelId is string
        && request.resource.data.channelId.size() <= 64;

      // Messages are immutable after sent; author can delete
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
    }

    // Poll Votes Rules
    match /poll_votes/{voteId} {
      // Allow reading votes
      allow read: if isSignedIn();

      // One vote per user (document ID usually encoded as {pollId}_{uid} or userId verified)
      allow create: if isSignedIn()
        && isValidId(voteId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.pollId is string
        && request.resource.data.pollId.size() <= 128
        && request.resource.data.optionId is string
        && request.resource.data.optionId.size() <= 64;

      allow update: if false;
      allow delete: if false;
    }

    // Custom VOD Programs
    match /custom_vods/{vodId} {
      // Anyone can browse custom uploaded VOD items
      allow read: if true;

      allow create: if isSignedIn()
        && isValidId(vodId)
        && request.resource.data.uploaderUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.streamUrl is string
        && request.resource.data.streamUrl.size() <= 1000;

      allow update: if isSignedIn()
        && resource.data.uploaderUid == request.auth.uid
        && request.resource.data.uploaderUid == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.uploaderUid == request.auth.uid;
    }

    // Broadcast Channels (Public TV Guide & Channel Ribbon)
    match /broadcast_channels/{channelId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(channelId);
    }

    // 24/7 Channel Playout Timelines (Wall-Clock Master Sync)
    match /channel_timelines/{channelId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(channelId);
    }
  }
}

